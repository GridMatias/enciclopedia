# Generated artifacts are reproducible from pages + figures + _rules/
_exports/**
!_exports/
!_exports/README.md

# Python bytecode (tooling is source-only)
__pycache__/
*.pyc

# OS / editor noise
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store
*.tmp
*~
.vscode/
.idea/

# Machine-generated retrieval index (regenerated by _tools/enc_index.py)
_index/

# Safety net: credentials must never exist inside the encyclopedia (SKILL.md §1.6),
# but if one lands here by accident it must not reach the remote.
.env
.env.*
*.pem
*.key

# Nothing else is blanket-ignored, on purpose.
# Originals under <project>/_originals/ MUST stay versioned: a company or a lab is
# often legally required to keep the source document (PROTOCOL-CHANGELOG 1.2.0).
# For large binaries use git-lfs, never .gitignore.
